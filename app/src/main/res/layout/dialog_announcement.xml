<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
    <androidx.cardview.widget.CardView android:id="@+id/cardAnnouncement"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A2E" app:cardCornerRadius="24dp" app:cardElevation="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📢 使用公告" android:textColor="#FFFFFF"
                android:textSize="20sp" android:textStyle="bold" />
            <View android:layout_width="40dp" android:layout_height="3dp"
                android:layout_marginTop="12dp" android:background="#6C63FF" />
            <ScrollView android:layout_width="match_parent" android:layout_height="360dp"
                android:layout_marginTop="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/announcement_text"
                    android:textColor="#B0B0C3" android:textSize="14sp" />
            </ScrollView>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAgree"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="20dp" android:text="我已知晓"
                android:textColor="#FFFFFF" android:textSize="16sp"
                app:backgroundTint="#6C63FF" app:cornerRadius="16dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
